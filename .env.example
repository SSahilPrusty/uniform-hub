# ==============================================================
# UNIFORM HUB - ENVIRONMENT VARIABLES
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Database Configuration
# For quick local setup without external daemon, SQLite is supported:
DATABASE_URL="file:./dev.db"
# For PostgreSQL (via Docker or local PostgreSQL server):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/uniform_hub?schema=public"

# Authentication & Security
JWT_SECRET="uniform_hub_super_secret_jwt_key_2026_change_in_prod!"
JWT_EXPIRES_IN="7d"

# Storage Settings
# 'local' saves to apps/api/uploads, 's3' or 'cloud' can be configured for cloud object storage
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Payment Gateway (Razorpay / PayTM / Stripe Integration)
# In development, leave empty or set to test mode for simulated payments
PAYMENT_MODE="test"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email Notifications (SMTP / Resend / SendGrid)
# When empty, system logs email notifications to the console without breaking
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="notifications@uniformhub.in"
