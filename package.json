{
  "name": "uniform-hub",
  "version": "1.0.0",
  "description": "UNIFORM HUB - Multi-Vendor School Uniform E-Commerce Marketplace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build:all",
    "build:all": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "deploy": "npx wrangler deploy",
    "deploy:pages": "npx wrangler pages deploy apps/web/dist --project-name=uniformhub",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma seed",
    "db:studio": "npx prisma studio"
  },
  "keywords": [
    "school-uniforms",
    "marketplace",
    "ecommerce",
    "uniform-hub",
    "react",
    "express",
    "prisma"
  ],
  "author": "Uniform Hub Engineering Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  }
}
