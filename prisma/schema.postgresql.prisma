datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & ROLE MANAGEMENT
// -------------------------------------------------------------

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  phone            String?
  role             String            @default("CUSTOMER") // CUSTOMER, SCHOOL_ADMIN, FRANCHISE_ADMIN, TAILOR, ADMIN, SUPER_ADMIN
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customerProfile  CustomerProfile?
  schoolProfile    SchoolProfile?
  franchiseProfile FranchiseProfile?
  tailorProfile    TailorProfile?
  addresses        Address[]
  carts            Cart[]
  orders           Order[]
  measurements     CustomMeasurement[]
  catalogRequests  SchoolCatalogRequest[]
  supportTickets   SupportTicket[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  userRoles        UserRole[]
  assignedOrders      OrderAssignment[]        @relation("AssignedByAdmin")
  assignmentHistories AssignmentHistory[]      @relation("ChangedByUser")
  statusHistories     ProductionStatusHistory[] @relation("StatusChangedByUser")

  @@index([email])
  @@index([role])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  action          String           @unique // e.g. "products:create", "schools:approve"
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// -------------------------------------------------------------
// PROFILES & PARTNERS
// -------------------------------------------------------------

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  loyaltyPoints    Int      @default(0)
  defaultAddressId String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  code            String?              @unique
  logo            String?
  address         String
  city            String
  district        String?
  state           String
  pincode         String
  contactEmail    String?
  contactPhone    String?
  description     String?
  isVerified      Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  schoolProfile   SchoolProfile?
  products        Product[]
  schoolProducts  SchoolProduct[]
  catalogRequests SchoolCatalogRequest[]
  productImages   ProductImage[]

  @@index([city])
  @@index([state])
  @@index([isVerified])
}

model SchoolProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  schoolId     String   @unique
  principalName String?
  designation  String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FranchiseProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  businessName    String
  ownerName       String
  contactPhone    String
  address         String
  city            String
  state           String
  gstNumber       String?
  serviceArea     String?
  isVerified      Boolean   @default(false)
  commissionRate  Float     @default(10.0) // default 10% platform fee
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  inventories     Inventory[]
  vendorPayouts   VendorPayout[]
}

model TailorProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  shopName        String
  tailorName      String
  phone           String
  address         String
  city            String
  state           String
  skills          String?        // e.g. "Pattern Making, Blazer Stitching, Custom Fitting"
  specializations String?        // e.g. "Blazers, Shirts, Trousers"
  experience      String?        // e.g. "10 years in school uniform tailoring"
  documentsUrl    String?        // uploaded certificates / documents reference
  serviceArea     String?
  approvalStatus  String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectedById    String?
  isVerified      Boolean        @default(true)
  isAvailable     Boolean        @default(true)
  maxActiveOrders Int            @default(10)
  activeOrderCount Int           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoringJobs   TailoringJob[]
  assignments     OrderAssignment[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  pincode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// PRODUCT CATALOG & INVENTORY
// -------------------------------------------------------------

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id               String                  @id @default(uuid())
  name             String
  slug             String                  @unique
  description      String
  categoryId       String
  schoolId         String?
  franchiseId      String?
  gender           String                  @default("UNISEX") // BOYS, GIRLS, UNISEX
  fabricDetails    String?
  careInstructions String?
  status           String                  @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, INACTIVE
  isFeatured       Boolean                 @default(false)
  allowTailoring   Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  category         ProductCategory         @relation(fields: [categoryId], references: [id])
  school           School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  franchise        FranchiseProfile?       @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  schoolProducts   SchoolProduct[]
  cartItems        CartItem[]
  approvalRequests ProductApprovalRequest[]

  @@index([categoryId])
  @@index([schoolId])
  @@index([status])
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String
  sku          String      @unique
  size         String      // e.g. "28", "30", "M", "L"
  color        String?     // e.g. "Navy Blue", "White"
  mrp          Float       // Original Maximum Retail Price
  sellingPrice Float       // Discounted/Actual selling price
  stock        Int         @default(0)
  isAvailable  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  inventories  Inventory[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  schoolId   String?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([schoolId])
  @@index([isPrimary])
}

model SchoolProduct {
  id         String   @id @default(uuid())
  schoolId   String
  productId  String
  isMandatory Boolean @default(false)
  gradeLevel String?  // e.g. "Primary (Classes 1-5)", "Middle", "Senior"
  notes      String?
  createdAt  DateTime @default(now())

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([schoolId, productId])
}

model Inventory {
  id          String           @id @default(uuid())
  variantId   String
  franchiseId String
  quantity    Int              @default(0)
  reservedQty Int              @default(0)
  lowStockAlert Int            @default(5)
  updatedAt   DateTime         @updatedAt

  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  franchise   FranchiseProfile @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([variantId, franchiseId])
}

// -------------------------------------------------------------
// CART & CHECKOUT
// -------------------------------------------------------------

model Cart {
  id          String     @id @default(uuid())
  userId      String?
  sessionId   String?    @unique
  couponCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@index([userId])
}

model CartItem {
  id                  String             @id @default(uuid())
  cartId              String
  productId           String
  variantId           String
  quantity            Int                @default(1)
  customMeasurementId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  cart                Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  measurement         CustomMeasurement? @relation(fields: [customMeasurementId], references: [id], onDelete: SetNull)

  @@unique([cartId, variantId])
}

// -------------------------------------------------------------
// ORDERS & FULFILLMENT
// -------------------------------------------------------------

model Order {
  id                String         @id @default(uuid())
  orderNumber       String         @unique
  userId            String
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddressJson String       // Stored JSON of snapshot address
  subtotal          Float
  discount          Float          @default(0.0)
  deliveryFee       Float          @default(0.0)
  taxAmount         Float          @default(0.0)
  totalAmount       Float
  status            String         @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, etc.
  paymentMethod     String         @default("TEST_GATEWAY")
  paymentStatus     String         @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentReference  String?
  trackingNumber    String?
  courierPartner    String?
  productionStatus  String         @default("PENDING") // PENDING, AWAITING_TAILOR_ASSIGNMENT, ASSIGNED, ACCEPTED, IN_PROGRESS, QUALITY_CHECK, READY_FOR_DISPATCH, DISPATCHED, DELIVERED, CANCELLED
  priority          String         @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  expectedCompletionDate DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  tailoringJobs     TailoringJob[]
  assignments       OrderAssignment[]
  assignmentHistories AssignmentHistory[]
  productionHistory ProductionStatusHistory[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([productionStatus])
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  productId           String
  productName         String
  variantId           String
  variantSku          String
  size                String
  color               String?
  price               Float
  quantity            Int
  subtotal            Float
  productImageUrl     String?
  customMeasurementId String?
  createdAt           DateTime       @default(now())

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tailoringJobs       TailoringJob[]

  @@index([orderId])
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  amount          Float
  currency        String   @default("INR")
  provider        String   // "TEST_MODE", "RAZORPAY", "COD"
  transactionRef  String?  @unique
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED
  signature       String?
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Refund {
  id         String   @id @default(uuid())
  orderId    String
  amount     Float
  reason     String
  status     String   @default("PENDING") // PENDING, PROCESSED, REJECTED
  refundRef  String?
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  trackingNumber String
  courierName    String
  status         String    @default("LABEL_CREATED")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// TAILORING & MEASUREMENTS
// -------------------------------------------------------------

model CustomMeasurement {
  id            String         @id @default(uuid())
  userId        String
  studentName   String
  gender        String         @default("BOYS") // BOYS, GIRLS
  chest         Float?
  waist         Float?
  shoulder      Float?
  sleeveLength  Float?
  shirtLength   Float?
  trouserLength Float?
  hip           Float?
  skirtLength   Float?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  tailoringJobs TailoringJob[]

  @@index([userId])
}

model TailoringJob {
  id                    String            @id @default(uuid())
  jobCode               String            @unique
  orderId               String
  orderItemId           String
  tailorId              String?
  status                String            @default("NEW") // NEW, ASSIGNED, ACCEPTED, MEASUREMENTS_REQUIRED, IN_PROGRESS, QUALITY_CHECK, READY, COMPLETED, CANCELLED
  customerMeasurementId String
  scheduledDate         DateTime?
  completedDate         DateTime?
  tailorNotes           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem             OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  tailor                TailorProfile?    @relation(fields: [tailorId], references: [id], onDelete: SetNull)
  measurement           CustomMeasurement @relation(fields: [customerMeasurementId], references: [id], onDelete: Cascade)

  @@index([tailorId])
  @@index([status])
}

// -------------------------------------------------------------
// ORDER-TO-TAILOR ASSIGNMENT & PRODUCTION STATUS TRACKING
// -------------------------------------------------------------

model OrderAssignment {
  id                     String         @id @default(uuid())
  orderId                String
  tailorId               String
  assignedById           String?
  assignmentMethod       String         @default("AUTOMATIC") // AUTOMATIC, MANUAL
  status                 String         @default("ASSIGNED") // ASSIGNED, ACCEPTED, REJECTED, COMPLETED, CANCELLED
  rejectionReason        String?
  reassignmentReason     String?
  expectedCompletionDate DateTime?
  notes                  String?
  assignedAt             DateTime       @default(now())
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tailor                 TailorProfile  @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  assignedBy             User?          @relation("AssignedByAdmin", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tailorId])
  @@index([status])
}

model AssignmentHistory {
  id               String         @id @default(uuid())
  orderId          String
  previousTailorId String?
  newTailorId      String?
  changedById      String?
  action           String         // AUTO_ASSIGNED, MANUALLY_ASSIGNED, REASSIGNED, ACCEPTED, REJECTED, CANCELLED
  reason           String?
  createdAt        DateTime       @default(now())

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy        User?          @relation("ChangedByUser", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([action])
}

model ProductionStatusHistory {
  id             String         @id @default(uuid())
  orderId        String
  previousStatus String?
  newStatus      String
  changedById    String?
  notes          String?
  createdAt      DateTime       @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy      User?          @relation("StatusChangedByUser", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([newStatus])
}

// -------------------------------------------------------------
// REQUESTS, SETTINGS & AUDIT
// -------------------------------------------------------------

model SchoolCatalogRequest {
  id                 String   @id @default(uuid())
  schoolId           String?
  userId             String?
  schoolName         String
  city               String
  state              String
  requesterName      String
  requesterRole      String
  requesterEmail     String
  requesterPhone     String
  uniformDescription String
  referenceImageUrl  String?
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school             School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ProductApprovalRequest {
  id          String   @id @default(uuid())
  productId   String
  submittedBy String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes       String?
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float?
  discountAmount  Float?
  minOrderAmount  Float    @default(0.0)
  maxDiscount     Float?
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model CommissionRule {
  id             String   @id @default(uuid())
  roleType       String   // "FRANCHISE", "TAILOR"
  percentage     Float    @default(10.0)
  fixedFee       Float    @default(0.0)
  description    String?
  isActive       Boolean  @default(true)
}

model VendorPayout {
  id          String           @id @default(uuid())
  franchiseId String
  amount      Float
  status      String           @default("PENDING") // PENDING, COMPLETED
  reference   String?
  createdAt   DateTime         @default(now())

  franchise   FranchiseProfile @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id         String   @id @default(uuid())
  userId     String
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  response   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, ORDER, APPROVAL, ALERT
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  action     String   // e.g. "PRODUCT_APPROVED", "IMAGE_ASSIGNED", "USER_ROLE_CHANGED"
  entityType String   // e.g. "Product", "ProductImage", "User", "Order"
  entityId   String?
  details    String?  // JSON details
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
}
